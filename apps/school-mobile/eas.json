{
  "cli": { "version": ">= 13.0.0", "appVersionSource": "local" },
  "build": {
    "preview": {
      "distribution": "internal",
      "env": {
        "EAS_BUILD_PROFILE": "preview",
        "EXPO_PUBLIC_API_URL": "https://erp.stlukestura.in/api",
        "EXPO_PUBLIC_TENANT_SLUG": "st-lukes-tura",
        "EXPO_PUBLIC_APP_NAME": "St. Luke's School",
        "EXPO_PUBLIC_LOGIN_HOST": "erp.stlukestura.in"
      },
      "android": { "buildType": "apk" }
    },
    "production": {
      "env": {
        "EAS_BUILD_PROFILE": "production",
        "EXPO_PUBLIC_API_URL": "https://erp.stlukestura.in/api",
        "EXPO_PUBLIC_TENANT_SLUG": "st-lukes-tura",
        "EXPO_PUBLIC_APP_NAME": "St. Luke's School",
        "EXPO_PUBLIC_LOGIN_HOST": "erp.stlukestura.in"
      },
      "android": { "buildType": "app-bundle" }
    }
  }
}
