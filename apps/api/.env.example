# Host port 15432 maps to Postgres in docker-compose (avoids conflict with local PostgreSQL on 5432).
DATABASE_URL=postgresql://nep:nep_dev_password@127.0.0.1:15432/nep_erp
REDIS_URL=redis://127.0.0.1:6379
PORT=3001
WEB_ORIGIN=http://localhost:3000
# Local dev: map localhost / 127.0.0.1 logins to this tenant domain (seed creates demo.localhost).
DEV_LOGIN_HOST=demo.localhost
# Comma-separated extra CORS origins for production (e.g. http://192.168.1.10:3000)
CORS_EXTRA_ORIGINS=

JWT_ACCESS_SECRET=change-me-access-min-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-min-32-characters-long
JWT_ACCESS_TTL=1200s
JWT_MOBILE_ACCESS_TTL=12h
JWT_REFRESH_TTL=7d
JWT_REFRESH_TTL_REMEMBER=30d

# Email (optional — omit SMTP_HOST for dev-log mode)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@demo.edu
SMTP_FROM_NAME=

# School admissions mailbox (Tura Public School Hostinger). Do not use the college SMTP account.
# Local/dev: smtp.hostinger.com:465 SSL. Do not commit SCHOOL_SMTP_PASS. Replace for production.
SCHOOL_SMTP_HOST=smtp.hostinger.com
SCHOOL_SMTP_PORT=465
SCHOOL_SMTP_SECURE=true
SCHOOL_SMTP_USER=info@turapublicschool.com
SCHOOL_SMTP_PASS=
SCHOOL_SMTP_FROM=info@turapublicschool.com
SCHOOL_SMTP_FROM_NAME=Tura Public School
SCHOOL_ADMISSIONS_LOGIN_URL=http://admission.tps.localhost:3000/school-admissions-portal/login
# Production: https://admission.turapublicschool.com/school-admissions-portal/login

# SMS (optional — set SMS_ENABLED=true when gateway credentials are configured)
SMS_ENABLED=false
SMS_BASE_URL=
SMS_USERNAME=
SMS_PASSWORD=

# WhatsApp Meta Business API (optional)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
SMS_SENDER=
SMS_PRIORITY=1
SMS_DLT_TEMPLATE_ID=
SMS_DLT_CTA_ID=
SMS_ADMISSIONS_LOGIN_URL=
SMS_ADMISSIONS_TEMPLATE=

# Razorpay (optional — omit for office-only fee collection)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
ADMISSIONS_APPLICATION_FEE=600

# Storage (local disk default; set s3 or r2 for production object storage)
STORAGE_ROOT=storage
UPLOAD_ROOT=uploads
STORAGE_DRIVER=local
AWS_S3_BUCKET=
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
CDN_URL=

# Background jobs: api = Nest export processors (student import, bulk update, …)
PROCESS_BACKGROUND_JOBS=api
# Production: set true when a worker container generates fee receipt PDFs
# FEE_RECEIPT_PDF_ON_WORKER=true

# Applicant portal password-reset links (optional — derived from request Host if unset)
ADMISSIONS_PORTAL_ORIGIN=http://admissions.demo.localhost:3000

# Firebase Cloud Messaging for St. Luke's School app (server only — never put these in the web/mobile client).
# Local/dev: SCHOOL_FCM_DEMO_MODE=true logs sends without calling Google.
SCHOOL_FCM_DEMO_MODE=true
# Public API origin used in notification image/PDF URLs (FCM image banners need a URL Google can fetch).
# Production: https://erp.stlukestura.in  Local: http://127.0.0.1:3001 (phones cannot fetch this for lock-screen images).
API_PUBLIC_ORIGIN=http://127.0.0.1:3001
# Preferred: service account JSON from Firebase project st-lukes-school-6f471
# (Project settings → Service accounts → Generate new private key). Do not commit the file.
# SCHOOL_FIREBASE_SERVICE_ACCOUNT_FILE=C:\\secure\\stlukes-firebase-adminsdk.json
# SCHOOL_FIREBASE_SERVICE_ACCOUNT_JSON=
SCHOOL_FCM_PROJECT_ID=st-lukes-school-6f471
SCHOOL_FCM_CLIENT_EMAIL=
# Use literal \n for newlines when storing the PEM in .env
SCHOOL_FCM_PRIVATE_KEY=

# St. Luke's SMS (API.txt). Do not use college SMS_* keys.
# Dashboard → API Keys. sendMsg = plain SMS; sendFlow = personalized DLT variables; sendOTP = login.
SCHOOL_APITXT_AUTHKEY=
SCHOOL_APITXT_SENDER=
SCHOOL_APITXT_PE_ID=
SCHOOL_APITXT_TEMPLATE_ID=
SCHOOL_APITXT_ROUTE=4
SCHOOL_APITXT_OTP_TEMPLATE_ID=
SCHOOL_APITXT_TEMPLATE_NAME=
SCHOOL_APITXT_CHANNEL=sms
SCHOOL_APITXT_COUNTRY=91
# SCHOOL_APITXT_PROJECT_REF_ID=
# SCHOOL_APITXT_OTP_URL=https://apitxt.com/api/sendOTP
# SCHOOL_APITXT_SEND_URL=https://apitxt.com/api/sendMsg
# SCHOOL_APITXT_FLOW_URL=https://apitxt.com/api/sendFlow

# Shared with BaseCode Labs website for license key ingest
LICENSE_SYNC_SECRET=

# School ERP signed licensing (Ed25519). Private key MUST exist only on the license server.
# Generate with: npx ts-node --compiler-options {\"module\":\"commonjs\"} apps/api/scripts/generate-school-license-keys.ts
LICENSE_SERVER_URL=
LICENSE_VALIDATION_INTERVAL=86400
LICENSE_OFFLINE_GRACE_PERIOD=72
LICENSE_CACHE_DURATION=3600
LICENSE_PUBLIC_KEY=
LICENSE_PRIVATE_KEY=

# BaseCode Central — production: https://basecodelabs.com (must be reachable from the school API VPS)
# Local: http://127.0.0.1:1610
BASECODE_CENTRAL_URL=http://127.0.0.1:1610
# Same value as BASECODE_LICENSE_API_SECRET on apps/basecode-labs. Required in production.
BASECODE_LICENSE_API_SECRET=

# Principal Communication Hub — Google Workspace / Gmail OAuth (Principal-only mailbox)
# Redirect URI must match Google Cloud Console (e.g. http://localhost:3001/api/v1/principal-comms/accounts/oauth/callback)
GOOGLE_COMMS_CLIENT_ID=
GOOGLE_COMMS_CLIENT_SECRET=
GOOGLE_COMMS_REDIRECT_URI=http://localhost:3001/api/v1/principal-comms/accounts/oauth/callback
WEB_APP_URL=http://localhost:3000
# Optional dedicated AES key for mailbox tokens (falls back to ENCRYPTION_KEY)
PRINCIPAL_COMMS_TOKEN_KEY=
