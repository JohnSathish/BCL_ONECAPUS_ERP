# EAS upload ignore — replaces .gitignore for the build archive.
# Intentionally allows google-services.json so FCM works on cloud builds.

.expo/
node_modules/
dist/
web-build/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
.env
.env.local
.env.production
*.apk
*.aab
onecampus-*.apk

# Native build caches (keep project tiny for EAS upload; avoid Windows file locks)
android/
ios/
**/.gradle/
**/*.lock
**/checksums.lock
**/build/
!android/app/src/**/build/
android/keystore.properties
