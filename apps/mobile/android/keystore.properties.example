# Copy to keystore.properties (gitignored) — never commit secrets or the .jks file.
#
# Generate upload key (once):
#   keytool -genkeypair -v -storetype PKCS12 -keystore onecampus-upload.jks \
#     -alias onecampus -keyalg RSA -keysize 2048 -validity 10000
#
# Prefer EAS managed credentials for Play uploads:
#   cd apps/mobile && npm run build:prod:android

MYAPP_UPLOAD_STORE_FILE=../onecampus-upload.jks
MYAPP_UPLOAD_STORE_PASSWORD=change-me
MYAPP_UPLOAD_KEY_ALIAS=onecampus
MYAPP_UPLOAD_KEY_PASSWORD=change-me
