# Local development (optional — seeds institution on first launch; omit for universal picker)
# EXPO_PUBLIC_API_URL=http://localhost:3001/api
# EXPO_PUBLIC_TENANT_SLUG=demo

# Universal mode — institution directory (see docs/universal-app.md)
# EXPO_PUBLIC_SCHOOL_REGISTRY_URL=https://basecodelabs.com/onecampus-schools.json

# Production single-college build (skips picker when set)
# EXPO_PUBLIC_API_URL=https://erp.donboscocollege.ac.in/api
# EXPO_PUBLIC_TENANT_SLUG=demo
# EXPO_PUBLIC_APP_NAME=DBC Student
# EXPO_PUBLIC_PRIVACY_POLICY_URL=https://donboscocollege.ac.in/mobile-privacy.html
# EXPO_PUBLIC_SUPPORT_EMAIL=principaldbct@gmail.com

# Physical device / Android emulator: use your PC LAN IP instead of localhost, e.g.
# EXPO_PUBLIC_API_URL=http://192.168.1.10:3001/api