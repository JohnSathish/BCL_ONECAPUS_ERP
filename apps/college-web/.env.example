# Don Bosco College public website (college-web)
# Copy to apps/college-web/.env.local for local development.
# Production values live in /opt/nep-erp/.env (see scripts/deploy/production.env.example).

# Canonical public URL (SEO, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://donboscocollege.ac.in

# Browser-facing API prefix (nginx proxies /api → Nest on the apex domain)
NEXT_PUBLIC_API_URL=/api

# SSR → Nest inside Docker (local: http://127.0.0.1:3001)
API_INTERNAL_ORIGIN=http://127.0.0.1:3001

# CMS tenant (must match Website CMS tenant slug — usually demo for DBC)
COLLEGE_TENANT_SLUG=demo
NEXT_PUBLIC_TENANT_SLUG=demo

# Host used for tenant domain resolution when slug is omitted
COLLEGE_CMS_HOST=donboscocollege.ac.in

# ERP login CTA / /erp redirect
NEXT_PUBLIC_ERP_LOGIN_URL=https://erp.donboscocollege.ac.in/login

# Optional: protect CMS publish revalidation webhook
# REVALIDATE_SECRET=

# Optional: external forms gateway for contact/newsletter
# COLLEGE_FORMS_URL=
# COLLEGE_FORMS_TOKEN=
# COLLEGE_CONTACT_RECIPIENT=info@donboscocollege.ac.in

# Visitors counter baseline (persisted in .data/visitors.json via Docker volume).
# New visits count once per IP+UA per Asia/Kolkata day (bots ignored).
# VISITOR_COUNT_BASE=12847
# VISITOR_HASH_SALT=change-me-in-production
