DATABASE_URL="file:./dev.db"
APP_URL="http://localhost:1610"
JWT_SECRET="replace-with-a-long-random-secret"
LICENSE_SIGNING_SECRET="replace-with-a-second-long-random-secret"
ADMIN_EMAIL="contact@basecodelabs.com"
ADMIN_NAME="BaseCode Labs Admin"

# Shared with the school ERP API (apps/api BASECODE_LICENSE_API_SECRET). Required in production.
BASECODE_LICENSE_API_SECRET=""

# Production: required. Login codes are emailed; they are never shown on the login page.
# Hostinger example: smtp.hostinger.com port 465, SMTP_SECURE=true, FROM must match the mailbox.
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="BaseCode Labs <contact@basecodelabs.com>"

# Optional Google Analytics
NEXT_PUBLIC_GA_ID=""
