# St. Luke's Secondary School, Tura — isolated vhosts (generated by vps-configure-st-lukes.sh).
# Public site: https://stlukestura.in
# School ERP:  https://erp.stlukestura.in
# Does NOT modify Don Bosco / Mercy / Diocese / TPS server blocks.
# Do NOT add admission.stlukestura.in (that prefix is reserved for TPS KG admissions).

# ── HTTP: ACME + redirect ──
server {
  listen 80;
  server_name stlukestura.in www.stlukestura.in erp.stlukestura.in;

  location /.well-known/acme-challenge/ {
    root /var/www/certbot;
  }

  location / {
    return 301 https://$host$request_uri;
  }
}

# ── HTTPS: www → apex ──
server {
  listen 443 ssl;
  http2 on;
  server_name www.stlukestura.in;

  ssl_certificate     /etc/letsencrypt/live/stlukestura.in/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/stlukestura.in/privkey.pem;
  ssl_session_cache   shared:SSL:10m;
  ssl_session_timeout 1d;
  ssl_protocols       TLSv1.2 TLSv1.3;

  return 301 https://stlukestura.in$request_uri;
}

# ── HTTPS: public school website ──
server {
  listen 443 ssl;
  http2 on;
  server_name stlukestura.in;

  ssl_certificate     /etc/letsencrypt/live/stlukestura.in/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/stlukestura.in/privkey.pem;
  ssl_session_cache   shared:SSL:10m;
  ssl_session_timeout 1d;
  ssl_protocols       TLSv1.2 TLSv1.3;

  client_max_body_size 64m;

  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  add_header X-Frame-Options "DENY" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;

  location /api/ {
    proxy_pass         http://api_upstream;
    proxy_http_version 1.1;
    proxy_set_header   Connection "close";
    proxy_set_header   Host $host;
    proxy_set_header   X-Real-IP $remote_addr;
    proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header   X-Forwarded-Proto $scheme;
    proxy_set_header   X-Forwarded-Host $host;
    proxy_set_header   X-Login-Host $host;
    proxy_connect_timeout 15s;
    proxy_read_timeout 120s;
    proxy_send_timeout 120s;
  }

  location /uploads/ {
    proxy_pass         http://api_upstream;
    proxy_http_version 1.1;
    proxy_set_header   Host $host;
    proxy_set_header   X-Real-IP $remote_addr;
    proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header   X-Forwarded-Proto $scheme;
    proxy_set_header   X-Login-Host $host;
  }

  location / {
    proxy_pass         http://web_upstream;
    proxy_http_version 1.1;
    proxy_set_header   Host $host;
    proxy_set_header   X-Real-IP $remote_addr;
    proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header   X-Forwarded-Proto $scheme;
    proxy_set_header   X-Forwarded-Host $host;
    add_header Cache-Control "private, no-cache, no-store, max-age=0, must-revalidate" always;
  }
}

# ── HTTPS: school ERP / office ──
server {
  listen 443 ssl;
  http2 on;
  server_name erp.stlukestura.in;

  ssl_certificate     /etc/letsencrypt/live/stlukestura.in/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/stlukestura.in/privkey.pem;
  ssl_session_cache   shared:SSL:10m;
  ssl_session_timeout 1d;
  ssl_protocols       TLSv1.2 TLSv1.3;

  client_max_body_size 64m;

  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  add_header X-Frame-Options "DENY" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;

  location /api/ {
    proxy_pass         http://api_upstream;
    proxy_http_version 1.1;
    proxy_set_header   Connection "close";
    proxy_set_header   Host $host;
    proxy_set_header   X-Real-IP $remote_addr;
    proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header   X-Forwarded-Proto $scheme;
    proxy_set_header   X-Forwarded-Host $host;
    proxy_set_header   X-Login-Host $host;
    proxy_connect_timeout 15s;
    proxy_read_timeout 120s;
    proxy_send_timeout 120s;
  }

  location /uploads/ {
    proxy_pass         http://api_upstream;
    proxy_http_version 1.1;
    proxy_set_header   Host $host;
    proxy_set_header   X-Real-IP $remote_addr;
    proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header   X-Forwarded-Proto $scheme;
    proxy_set_header   X-Login-Host $host;
  }

  location /socket.io/ {
    proxy_pass         http://api_upstream;
    proxy_http_version 1.1;
    proxy_set_header   Upgrade $http_upgrade;
    proxy_set_header   Connection $connection_upgrade;
    proxy_set_header   Host $host;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
  }

  location / {
    proxy_pass         http://web_upstream;
    proxy_http_version 1.1;
    proxy_set_header   Host $host;
    proxy_set_header   X-Real-IP $remote_addr;
    proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header   X-Forwarded-Proto $scheme;
    proxy_set_header   X-Forwarded-Host $host;
  }
}
