# Standalone Koha ILS — Don Bosco College Tura
# Hosts: koha.donboscocollege.ac.in (OPAC), staff.koha.donboscocollege.ac.in (staff)
# Proxies to koha-web / koha-inout on koha_nginx_edge (not ERP app network).

# ── HTTP: ACME + redirect ──
server {
  listen 80;
  server_name koha.donboscocollege.ac.in staff.koha.donboscocollege.ac.in inout.donboscocollege.ac.in;

  location /.well-known/acme-challenge/ {
    root /var/www/certbot;
  }

  location / {
    return 301 https://$host$request_uri;
  }
}

# ── HTTPS: OPAC ──
server {
  listen 443 ssl;
  http2 on;
  server_name koha.donboscocollege.ac.in;

  ssl_certificate     /etc/letsencrypt/live/koha.donboscocollege.ac.in/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/koha.donboscocollege.ac.in/privkey.pem;
  ssl_session_cache   shared:SSL:10m;
  ssl_session_timeout 1d;
  ssl_protocols       TLSv1.2 TLSv1.3;

  client_max_body_size 64m;

  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  add_header X-Content-Type-Options "nosniff" always;

  location / {
    proxy_pass         http://koha-web:8080;
    proxy_http_version 1.1;
    proxy_connect_timeout 15s;
    proxy_set_header   Host $host;
    proxy_set_header   X-Real-IP $remote_addr;
    proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header   X-Forwarded-Proto $scheme;
    proxy_set_header   X-Forwarded-Host $host;
    proxy_read_timeout 120s;
  }
}

# ── HTTPS: staff intranet ──
server {
  listen 443 ssl;
  http2 on;
  server_name staff.koha.donboscocollege.ac.in;

  ssl_certificate     /etc/letsencrypt/live/koha.donboscocollege.ac.in/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/koha.donboscocollege.ac.in/privkey.pem;
  ssl_session_cache   shared:SSL:10m;
  ssl_session_timeout 1d;
  ssl_protocols       TLSv1.2 TLSv1.3;

  client_max_body_size 64m;

  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "SAMEORIGIN" always;

  location / {
    proxy_pass         http://koha-web:8081;
    proxy_http_version 1.1;
    proxy_connect_timeout 15s;
    proxy_set_header   Host $host;
    proxy_set_header   X-Real-IP $remote_addr;
    proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header   X-Forwarded-Proto $scheme;
    proxy_set_header   X-Forwarded-Host $host;
    proxy_read_timeout 180s;
  }
}

# ── HTTPS: Koha In/Out gate register (enable after DNS + certbot -d) ──
# Copied by vps-configure-koha.sh when the certificate includes this name.
server {
  listen 443 ssl;
  http2 on;
  server_name inout.donboscocollege.ac.in;

  ssl_certificate     /etc/letsencrypt/live/koha.donboscocollege.ac.in/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/koha.donboscocollege.ac.in/privkey.pem;
  ssl_session_cache   shared:SSL:10m;
  ssl_session_timeout 1d;
  ssl_protocols       TLSv1.2 TLSv1.3;

  client_max_body_size 32m;

  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "SAMEORIGIN" always;

  location / {
    proxy_pass         http://koha-inout:80;
    proxy_http_version 1.1;
    proxy_connect_timeout 15s;
    proxy_set_header   Host $host;
    proxy_set_header   X-Real-IP $remote_addr;
    proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header   X-Forwarded-Proto $scheme;
    proxy_set_header   X-Forwarded-Host $host;
    proxy_read_timeout 120s;
  }
}
