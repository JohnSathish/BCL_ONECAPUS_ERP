# BaseCode Labs public site + BaseCode Central on the shared ERP VPS.
# Isolated extra-site: does not join the Don Bosco Let's Encrypt certificate.
# DNS: A records for @ and www → 82.25.110.120

# ── HTTP: ACME + redirect ──
server {
  listen 80;
  server_name basecodelabs.com www.basecodelabs.com;

  location /.well-known/acme-challenge/ {
    root /var/www/certbot;
  }

  location / {
    return 301 https://$host$request_uri;
  }
}

# ── HTTPS: www → apex ──
server {
  listen 443 ssl;
  http2 on;
  server_name www.basecodelabs.com;

  ssl_certificate     /etc/letsencrypt/live/basecodelabs.com/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/basecodelabs.com/privkey.pem;
  ssl_session_cache   shared:SSL:10m;
  ssl_session_timeout 1d;
  ssl_protocols       TLSv1.2 TLSv1.3;

  return 301 https://basecodelabs.com$request_uri;
}

# ── HTTPS: company site + Central ──
server {
  listen 443 ssl;
  http2 on;
  server_name basecodelabs.com;

  ssl_certificate     /etc/letsencrypt/live/basecodelabs.com/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/basecodelabs.com/privkey.pem;
  ssl_session_cache   shared:SSL:10m;
  ssl_session_timeout 1d;
  ssl_protocols       TLSv1.2 TLSv1.3;

  client_max_body_size 32m;

  add_header Strict-Transport-Security "max-age=31536000" always;
  add_header X-Frame-Options "DENY" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;

  location / {
    proxy_pass         http://basecode-labs:1610;
    proxy_http_version 1.1;
    proxy_set_header   Host $host;
    proxy_set_header   X-Real-IP $remote_addr;
    proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header   X-Forwarded-Proto $scheme;
    proxy_set_header   X-Forwarded-Host $host;
    proxy_connect_timeout 10s;
    proxy_read_timeout 120s;
    proxy_send_timeout 120s;
  }
}
